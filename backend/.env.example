# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# PostgreSQL + PostGIS Configuration (SKPL Tabel 2.1)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sakuskill_db
DB_USER=postgres
DB_PASSWORD=ganti_password_lokal_anda

# Redis Cache Configuration (SKPL Tabel 2.1 & NFR-04)
REDIS_URL=redis://localhost:6379

# Parameter Hyperlocal & Auth (Open Decisions OD-11 & OD-15)
JWT_SECRET=ganti_dengan_secret_key_minimal_32_karakter
JWT_EXPIRES_IN=7d
DEFAULT_CAMPUS_LAT=-6.9311
DEFAULT_CAMPUS_LNG=107.7175
DEFAULT_HYPERLOCAL_RADIUS_METERS=3000

# External Providers Placeholder (OD-01 & OD-23 - Jangan isi secret asli di sini)
PAYMENT_GATEWAY_PROVIDER=midtrans_sandbox
PAYMENT_GATEWAY_SERVER_KEY=your_sandbox_server_key_here
PAYMENT_GATEWAY_WEBHOOK_SECRET=your_webhook_secret_here
STORAGE_BUCKET_URL=https://storage.example.com/sakuskill
