# ==============================================================================
# SakuSkill Mobile Environment Variables Template
# ==============================================================================
# Inject via command line:
#   flutter run --dart-define=ROUTER_API_KEY=your_key --dart-define=ROUTER_BASE_URL=your_url
# ==============================================================================

# LLM Provider Endpoint URL (Groq Cloud default or Local 9router)
ROUTER_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# LLM API Authentication Key (Optional: Can also be set in-app via UI Dialog)
ROUTER_API_KEY=gsk_your_groq_api_key_here

# LLM Model Name
ROUTER_MODEL=openai/gpt-oss-120b

# Campus Microservice Environment (development / staging / production)
APP_ENV=production
