    {
      "name": "10. [KERJAAN #1 & #2] Pelanggan Buat Record Payment Terpisah (Backend Set Status = pending)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const res = pm.response.json();",
              "pm.test(\"Status 201, Payment=pending & Order tetap accepted\", () => {",
              "  pm.response.to.have.status(201);",
              "  pm.expect(res.data.status_kode).to.eql(\"pending\");",
              "  pm.expect(res.data.relasi_order.order_status_kode).to.eql(\"accepted\");",
              "  pm.expect(res.data.disclaimer_mvp.bukan_uang_sungguhan).to.eql(true);",
              "});"
            ]
