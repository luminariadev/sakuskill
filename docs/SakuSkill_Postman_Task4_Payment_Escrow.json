              "const res = pm.response.json();",
              "if (res.data && res.data.token) pm.collectionVariables.set(\"token_provider\", res.data.token);",
              "pm.test(\"Status 201 Created & Token Penyedia Tersimpan\", () => pm.response.to.have.status(201));"
