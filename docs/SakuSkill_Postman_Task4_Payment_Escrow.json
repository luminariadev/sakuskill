      "name": "1. Register User A (Penyedia Jasa)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const res = pm.response.json();",
              "pm.collectionVariables.set(\"token_provider\", res.data.token);",
              "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nama\": \"Arya Penyedia Jasa\",\n  \"email\": \"arya.mvp.{{$timestamp}}@uinsgd.ac.id\",\n  \"kata_sandi\": \"PasswordAman123!\"\n}"
